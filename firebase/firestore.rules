rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Demo scope: the first workshop connected to the dashboard is La Santi Gomme.
    // Replace the fixed id with a tenant lookup once the workshop ERP contract exists.
    function isWorkshopStaff(workshopId) {
      return signedIn()
        && profile().data.workshopId == workshopId
        && profile().data.role in ['workshop_admin', 'workshop_staff'];
    }

    match /users/{userId} {
      // User profiles and roles are provisioned from the Firebase Console or
      // a trusted Admin SDK process, never by a client application.
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /workshops/{workshopId} {
      allow read: if isWorkshopStaff(workshopId);
      allow create, update, delete: if isWorkshopStaff(workshopId)
        && profile().data.role == 'workshop_admin';
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId)
        || isWorkshopStaff(resource.data.workshopId);
      allow create: if isOwner(customerId)
        && request.resource.data.workshopId == 'la-santi-gomme';
      allow update: if (isOwner(customerId)
          && request.resource.data.workshopId == resource.data.workshopId)
        || isWorkshopStaff(resource.data.workshopId);
      allow delete: if isWorkshopStaff(resource.data.workshopId);
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || isWorkshopStaff(resource.data.workshopId));
      allow create, update: if signedIn()
        && (request.resource.data.customerId == request.auth.uid
          || isWorkshopStaff(request.resource.data.workshopId));
      allow delete: if isWorkshopStaff(resource.data.workshopId);
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || isWorkshopStaff(resource.data.workshopId));
      allow create: if signedIn()
        && request.resource.data.workshopId == 'la-santi-gomme'
        && (request.resource.data.customerId == request.auth.uid
          || isWorkshopStaff(request.resource.data.workshopId));
      allow update: if isWorkshopStaff(resource.data.workshopId);
      allow delete: if isWorkshopStaff(resource.data.workshopId);
    }

    match /payments/{paymentId} {
      allow read: if isWorkshopStaff(resource.data.workshopId);
      allow create, update, delete: if isWorkshopStaff(resource.data.workshopId)
        && profile().data.role == 'workshop_admin';
    }

    match /services/{serviceId} {
      allow read: if isWorkshopStaff(resource.data.workshopId);
      allow create, update, delete: if isWorkshopStaff(resource.data.workshopId);
    }
  }
}
